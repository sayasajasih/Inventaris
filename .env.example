# Koneksi Postgres (Vercel Postgres / Neon / Supabase / Postgres lokal).
# Jika kosong, aplikasi memakai penyimpanan fallback berbasis file JSON (.data/assets.json)
# yang TIDAK persisten di lingkungan serverless seperti Vercel.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
